# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongo:27017/GameDB

# Port for the Node API server
PORT=3000

# Secret for signing login tokens (e.g. `openssl rand -hex 32`); replace the
# placeholder with your own value. If empty, a random one is used per run.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# How long a login lasts, e.g. 1d or 12h (default 1d)
JWT_EXPIRES_IN=1d
# Comma-separated emails of site admins. Matching verified accounts are
# promoted on startup and when created. Removing an email does not demote;
# use `npm run set-role -- <username> user` (see docs/admin.md).
SITE_ADMIN_EMAILS=
# Site address used in the links in emails
APP_URL=http://localhost:5173
# SMTP server for outgoing email; leave SMTP_HOST empty to print emails to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sweeple <no-reply@localhost>
# Sign in with GitHub and Google. Leave a pair empty to hide that button.
# Callback URLs to register: APP_URL + /api/auth/github/callback and
# APP_URL + /api/auth/google/callback (see docs/oauth.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
