# Copy this file to .env and fill in the values. Never commit .env.

# Connection string for MongoDB (the host "mongodb" is the Docker Compose service name)
MONGODB_URI=mongodb://mongo:27017/GameDB

# Port for the Node API server
PORT=3000

# Secret for signing login tokens (e.g. `openssl rand -hex 32`); replace the
# placeholder with your own value. If empty, a random one is used per run.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Site address used in the links in emails
APP_URL=http://localhost:5173
# SMTP server for outgoing email; leave SMTP_HOST empty to print emails to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sweeple <no-reply@localhost>
