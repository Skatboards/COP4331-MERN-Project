# Direct backend development example. Copy this file to backend/.env only when
# running Node on the host; never commit it. Compose supplies these values
# directly and production uses a protected release-specific environment file.

# Host-run backend connection. The Compose backend instead receives
# mongodb://mongo:27017/<MONGO_DATABASE> from the selected Compose file.
MONGODB_URI=mongodb://127.0.0.1:27017/GameDB

# Port for the Node API server
PORT=3000

# Secret for signing login tokens (e.g. `openssl rand -hex 32`). Replace this
# non-secret local placeholder. Production requires an explicit GitHub secret.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Optional login-token lifetime accepted by jsonwebtoken; defaults to 1d.
JWT_EXPIRES_IN=1d
# Site address used in the links in emails
APP_URL=http://localhost:5173
# SMTP server for outgoing email; leave SMTP_HOST empty to print emails to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
# Sign in with GitHub and Google. A direct development provider is enabled only
# when both values in its pair are present. Production requires both pairs.
# Callback URLs to register: APP_URL + /api/auth/github/callback and
# APP_URL + /api/auth/google/callback (see docs/oauth.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
