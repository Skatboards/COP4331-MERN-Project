meta {
  name: Search Users
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/api/users/search?q={{searchQuery}}&limit=10
  body: none
  auth: none
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a users array", function () {
    expect(res.getBody().users).to.be.an("array");
  });
}

docs {
  Find players by part of a username or name. Set `searchQuery` in the
  environment (seed data includes names like alexrivera).
}
