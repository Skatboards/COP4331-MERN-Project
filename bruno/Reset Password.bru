meta {
  name: Reset Password
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "password": "{{newPassword}}"
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a confirmation message", function () {
    expect(res.getBody().message).to.be.a("string");
  });
}

docs {
  Sets a new password using the token from the forgot-password email. Set
  secret `resetToken` from logs and `newPassword` in the environment (8+
  characters). Run Forgot Password first for that email.
}
