meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "Demo",
    "lastName": "User",
    "username": "{{newUsername}}",
    "email": "{{newUsername}}@example.com",
    "password": "demo-password-123"
  }
}

script:pre-request {
  // A new username each run, so the request can be sent more than once
  bru.setVar("newUsername", "demo" + Date.now().toString().slice(-8));
}

tests {
  test("returns 201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("returns a confirmation message", function () {
    expect(res.getBody().message).to.be.a("string");
  });
}

docs {
  Creates an account and emails a verification link. The new account can't
  log in until the link is opened (login returns 403 until then).
}
