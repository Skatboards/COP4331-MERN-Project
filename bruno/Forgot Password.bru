meta {
  name: Forgot Password
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a generic message", function () {
    expect(res.getBody().message).to.be.a("string");
  });
}

docs {
  Emails a password reset link for a registered address. Set `email` to a
  known account. Without SMTP, find the reset token in backend logs
  (`reset-password?token=`).
}
