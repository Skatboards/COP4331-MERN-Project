meta {
  name: Verify Email
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/verify-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{verifyToken}}"
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a confirmation message", function () {
    expect(res.getBody().message).to.be.a("string");
  });
}

docs {
  Verifies an account after Register. Set the secret `verifyToken` from the
  link in `docker compose logs backend` (query param on verify-email).
  Run Register first, then paste the token here before Login.
}
