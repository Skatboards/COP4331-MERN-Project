meta {
  name: Send Password Reset
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/admin/users/{{adminUserId}}/password-reset
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  if (!bru.getEnvVar("adminLogin")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("names the address the link went to", function () {
    expect(res.getBody().message).to.contain("@example.com");
  });
}

docs {
  Emails the account from Create User a password reset link.
}
