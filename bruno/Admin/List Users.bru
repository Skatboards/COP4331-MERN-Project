meta {
  name: List Users
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/admin/users?limit=20
  body: none
  auth: bearer
}

params:query {
  limit: 20
}

auth:bearer {
  token: {{adminToken}}
}

script:pre-request {
  if (!bru.getEnvVar("adminLogin")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns a page of accounts with a total", function () {
    const body = res.getBody();
    expect(body.users).to.be.an("array");
    expect(body.total).to.be.a("number");
    body.users.forEach((user) => expect(user).to.have.property("manageable"));
  });
}

docs {
  Accounts the admin can see, by username. Add `q` to search, or `role`
  (e.g. `admin,siteadmin`, site admins only) to filter.
}
