meta {
  name: My Attempts
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/users/me/attempts
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("returns an attempts array", function () {
    expect(res.getBody().attempts).to.be.an("array");
  });

  test("returns streak stats", function () {
    expect(res.getBody().stats.currentStreak).to.be.a("number");
    expect(res.getBody().stats.longestStreak).to.be.a("number");
  });
}

docs {
  The logged-in user's games, newest first, with stats (streaks, best
  efficiency, efficiency rank). Add `?from=2026-11-01&to=2026-11-30` to list one
  month of daily boards. Run Login (and optionally Record Attempt) first.
}
