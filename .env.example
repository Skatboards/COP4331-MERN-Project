# Local development defaults for compose.dev.yaml. Copy this file to .env.
# Production values are supplied by the protected GitHub production environment
# and are installed as a release-specific file; do not deploy this example.

# Optional image tag. Development defaults to "dev" when this is omitted.
# Production requires an immutable full commit SHA supplied by release.sh.
IMAGE_TAG=dev

# Host ports. Development publishes all three as shown. Production commonly
# uses CLIENT_PORT=5173 and BACKEND_PORT=3001 and binds both to 127.0.0.1;
# production MongoDB is not published to the host.
CLIENT_PORT=5173
BACKEND_PORT=3000
MONGO_DATABASE=GameDB
MONGO_PORT=27017

# Optional Vite development allowed-host setting. compose.prod.yaml and the
# optimized production client do not read or require DOMAIN.
DOMAIN=

# Secret for signing login tokens (any long random string, e.g. `openssl rand -hex 32`).
# Replace the non-secret placeholder locally; production requires a GitHub secret.
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
# Login-token lifetime accepted by jsonwebtoken (for example: 1d, 12h, 30m).
JWT_EXPIRES_IN=1d
# Site address used in the links in verification and password reset emails
APP_URL=http://localhost:5173
# SMTP server for outgoing email. Leave SMTP_HOST empty to print emails to the
# backend log instead (docker compose -f compose.dev.yaml logs backend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=
# Sign in with GitHub and Google. In development, leave a complete pair empty
# to hide that provider. Production requires both ID and secret for both
# providers and validates them before deployment.
# Callback URLs to register: APP_URL + /api/auth/github/callback and
# APP_URL + /api/auth/google/callback (see docs/oauth.md).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
