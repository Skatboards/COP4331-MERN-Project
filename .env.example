CLIENT_PORT=5173
BACKEND_PORT=3000
MONGO_DATABASE=GameDB
MONGO_PORT=27017

# Secret for signing login tokens (any long random string, e.g. `openssl rand -hex 32`).
# Leave empty locally; set it on the server so logins survive restarts.
JWT_SECRET=
# Site address used in the links in verification and password reset emails
APP_URL=http://localhost:5173
# SMTP server for outgoing email. Leave SMTP_HOST empty to print emails to the
# backend log instead (docker compose logs backend).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Sweeple <no-reply@localhost>
